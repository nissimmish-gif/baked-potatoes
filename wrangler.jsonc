{
  // Cloudflare Worker config. The dashboard's Worker name must match "name".
  // For now the Worker only serves the static site in public/.
  // The movie-data API (TMDB) will be added here as "main" later.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "baked-potatoes",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public"
  },
  "workers_dev": true,
  "preview_urls": true
}
